#include <stdio.h>
#include <string.h>

int main() {
    char str1[100], str2[100];
    int choice;

    while (1) {
        // Display the menu
        printf("\n--- STRING OPERATIONS MENU ---\n");
        printf("1. Find String Length\n");
        printf("2. Copy String\n");
        printf("3. Concatenate (Join) Two Strings\n");
        printf("4. Compare Two Strings\n");
        printf("5. Reverse a String\n");
        printf("6. Exit\n");
        printf("Enter your choice (1-6): ");
        scanf("%d", &choice);

        // Clear the newline character left by scanf
        getchar();

        if (choice == 6) {
            printf("Exiting program. Goodbye!\n");
            break;
        }

        switch (choice) {
            case 1:
                printf("Enter a string: ");
                gets(str1); // Note: fgets() is safer, but gets() is standard in beginner courses
                printf("Length of the string = %lu\n", strlen(str1));
                break;

            case 2:
                printf("Enter source string: ");
                gets(str1);
                strcpy(str2, str1);
                printf("Copied string = %s\n", str2);
                break;

            case 3:
                printf("Enter first string: ");
                gets(str1);
                printf("Enter second string: ");
                gets(str2);
                strcat(str1, str2);
                printf("Concatenated string = %s\n", str1);
                break;

            case 4:
                printf("Enter first string: ");
                gets(str1);
                printf("Enter second string: ");
                gets(str2);
                if (strcmp(str1, str2) == 0) {
                    printf("Both strings are EQUAL.\n");
                } else {
                    printf("Strings are NOT equal.\n");
                }
                break;

            case 5:
                printf("Enter a string to reverse: ");
                gets(str1);
                int len = strlen(str1);
                printf("Reversed string = ");
                for (int i = len - 1; i >= 0; i--) {
                    printf("%c", str1[i]);
                }
                printf("\n");
                break;

            default:
                printf("Invalid choice! Please select between 1 and 6.\n");
        }
    }

    return 0;
}
